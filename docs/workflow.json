{
  "version": 1,
  "models": {
    "draft": "openai-codex/gpt-5.6-luna:high",
    "review": "openai-codex/gpt-5.6-sol:medium",
    "summary": "openai-codex/gpt-5.6-luna:high",
    "checkpoint": "openai-codex/gpt-5.6-sol:medium",
    "compress": "openai-codex/gpt-5.6-luna:high"
