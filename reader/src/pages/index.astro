---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import cover from "../assets/cover.jpg";
import Remark42Counters from "../components/Remark42Counters.astro";
import { allChapters, chapterHref, groupedChapters, toIndex, withBase } from "../lib/chapters";

const entries = await allChapters();
const chapters = toIndex(entries);
const groups = groupedChapters(chapters);
const first = entries[0];
const firstHref = first ? chapterHref(first.data.chapter) : withBase("");
const wordMap = Object.fromEntries(entries.map((entry) => [String(entry.data.chapter), entry.data.wordCount]));
---

<Base title="Murim Login" description="Read Murim Login — a martial-world web novel translation.">
  <main class="wrap" data-page="index" data-count={chapters.length} data-words={JSON.stringify(wordMap)}>
    <section class="hero">
      <Picture
        class="cover-image"
        src={cover}
        formats={["avif", "webp"]}
        widths={[320, 480, 720]}
        sizes="(max-width: 40rem) min(70vw, 16rem), 16rem"
        alt="Murim Login cover"
        loading="eager"
        fetchpriority="high"
      />
      <h1>Murim Login</h1>
      <div class="cta-row">
        <a id="continue" class="button" hidden href={firstHref}>Continue reading</a>
        {
          first && (
            <a id="start" class="button" href={firstHref}>
              Start at {first.data.title}
            </a>
          )
        }
      </div>
      <div class="overall-progress" id="overall-progress" hidden>
        <p class="overall-label" id="overall-label"></p>
        <div
          class="overall-track"
          id="overall-bar"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
        >
          <span class="overall-fill" id="overall-fill"></span>
        </div>
      </div>
    </section>
    <section class="toc" aria-labelledby="toc-heading">
      <h2 id="toc-heading" class="toc-heading">Chapters</h2>
      <label class="filter-label">
        <span class="sr-only">Filter chapters</span>
        <input id="chapter-filter" type="search" placeholder="Filter chapters" />
      </label>
      {
        groups.map((group) => (
          <details class="chapter-range" data-start={group.start} data-end={group.end}>
            <summary>
              <span>{group.label}</span>
              <span class="range-count">{group.items.length}</span>
            </summary>
            <ol class="chapter-ol">
              {group.items.map((item) => (
                <li>
                  <a href={item.href} data-chapter={item.chapter}>
                    <span class="chapter-ol__title">{item.title}</span>
                    <span class="chapter-ol__meta">
                      <span class="remark42__counter" data-url={`chapter-${item.chapter}`}>0</span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </details>
        ))
      }
    </section>
  </main>
  <Remark42Counters />
</Base>
