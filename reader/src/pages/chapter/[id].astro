---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import ChapterNav from "../../components/ChapterNav.astro";
import ChapterDock from "../../components/ChapterDock.astro";
import Remark42 from "../../components/Remark42.astro";
import ViewCounters from "../../components/ViewCounters.astro";
import Previously from "../../components/Previously.astro";
import { allChapters, neighbors, readingMinutes, toRef, type ChapterEntry } from "../../lib/chapters";
import { loadPreviousSummary } from "../../lib/previousSummary";
import { loadTranslationProgress } from "../../lib/progress";

export async function getStaticPaths() {
  const entries = await allChapters();
  const polished = new Set(loadTranslationProgress().polished);
  return entries.map((entry) => {
    const { previous, next } = neighbors(entries, entry.data.chapter);
    return {
      params: { id: entry.id },
      props: {
        entry,
        previous: toRef(previous),
        next: toRef(next),
        polished: polished.has(entry.data.chapter),
      },
    };
  });
}

interface Props {
  entry: ChapterEntry;
  previous: ReturnType<typeof toRef>;
  next: ReturnType<typeof toRef>;
  polished: boolean;
}

const { entry, previous, next, polished } = Astro.props;
const { Content } = await render(entry);
const minutes = readingMinutes(entry.data.wordCount);
const description = `${entry.data.title} — about ${minutes} min read. A translation of Murim Login.`;
const previously = await loadPreviousSummary(entry.data.chapter);
---

<Base title={`${entry.data.title} — Murim Login`} chapter={entry.data.chapter} description={description}>
  <main class="wrap chapter-page" data-page="chapter" data-chapter={entry.data.chapter} data-polished={polished ? "1" : "0"}>
    <header class="chapter-header" data-pagefind-body>
      <p class="eyebrow">Murim Login</p>
      <h1 data-pagefind-meta="title">{entry.data.title}</h1>
      <p class="reading-meta">
        {entry.data.chapter} · {minutes} min read
        {" · "}
        <span class="chapter-views chapter-views--inline" title="Unique readers">
          <svg class="chapter-views__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M8 3.25C4.75 3.25 2.11 5.58 1 8.5c1.11 2.92 3.75 5.25 7 5.25s5.89-2.33 7-5.25c-1.11-2.92-3.75-5.25-7-5.25Zm0 8.75a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0-1.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"
            />
          </svg>
          <span class="view-counter" data-chapter={entry.data.chapter}>—</span>
          <span class="sr-only"> unique readers</span>
        </span>
        {polished && (
          <>
            {" · "}
            <span class="chapter-badge chapter-badge--polished">Polished</span>
          </>
        )}
      </p>
    </header>
    {previously && <Previously summary={previously} />}
    <ChapterNav previous={previous} next={next} />
    <article class="prose" data-pagefind-body>
      <Content />
    </article>
    <ChapterNav previous={previous} next={next} />
    <Remark42 chapter={entry.data.chapter} title={entry.data.title} />
  </main>
  <ChapterDock previous={previous} next={next} />
  <ViewCounters />
</Base>
