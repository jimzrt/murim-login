---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import ChapterNav from "../../components/ChapterNav.astro";
import ChapterDock from "../../components/ChapterDock.astro";
import Remark42 from "../../components/Remark42.astro";
import Previously from "../../components/Previously.astro";
import { allChapters, neighbors, readingMinutes, toRef, type ChapterEntry } from "../../lib/chapters";
import { loadPreviousSummary } from "../../lib/previousSummary";
import { loadTranslationProgress } from "../../lib/progress";

export async function getStaticPaths() {
  const entries = await allChapters();
  const mastered = new Set(loadTranslationProgress().mastered);
  return entries.map((entry) => {
    const { previous, next } = neighbors(entries, entry.data.chapter);
    return {
      params: { id: entry.id },
      props: {
        entry,
        previous: toRef(previous),
        next: toRef(next),
        mastered: mastered.has(entry.data.chapter),
      },
    };
  });
}

interface Props {
  entry: ChapterEntry;
  previous: ReturnType<typeof toRef>;
  next: ReturnType<typeof toRef>;
  mastered: boolean;
}

const { entry, previous, next, mastered } = Astro.props;
const { Content } = await render(entry);
const minutes = readingMinutes(entry.data.wordCount);
const description = `${entry.data.title} — about ${minutes} min read. A translation of Murim Login.`;
const previously = await loadPreviousSummary(entry.data.chapter);
---

<Base title={`${entry.data.title} — Murim Login`} chapter={entry.data.chapter} description={description}>
  <main class="wrap chapter-page" data-page="chapter" data-chapter={entry.data.chapter} data-mastered={mastered ? "1" : "0"}>
    <header class="chapter-header">
      <p class="eyebrow">Murim Login</p>
      <h1 data-pagefind-body data-pagefind-meta="title">{entry.data.title}</h1>
      <p class="reading-meta">
        {entry.data.chapter} · {minutes} min read
        {mastered && (
          <>
            {" · "}
            <span class="chapter-badge chapter-badge--mastered">Mastered</span>
          </>
        )}
      </p>
    </header>
    {previously && <Previously summary={previously} />}
    <ChapterNav previous={previous} next={next} />
    <article class="prose" data-pagefind-body>
      <Content />
    </article>
    <Remark42 chapter={entry.data.chapter} title={entry.data.title} />
    <ChapterNav previous={previous} next={next} />
  </main>
  <ChapterDock previous={previous} next={next} />
</Base>
