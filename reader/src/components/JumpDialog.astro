<dialog class="reader-dialog" id="jump-dialog" aria-labelledby="jump-title">
  <div class="dialog-head">
    <h2 id="jump-title">Jump to chapter</h2>
    <button type="button" class="icon-btn" id="jump-close" aria-label="Close">
      <span aria-hidden="true">×</span>
    </button>
  </div>
  <label class="dialog-label">
    <span class="sr-only">Chapter number</span>
    <input
      id="jump-input"
      type="text"
      inputmode="numeric"
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
      enterkeyhint="go"
      placeholder="Chapter number"
    />
  </label>
  <button type="button" class="jump-to-current" id="jump-to-current" hidden>Current chapter</button>
  <div class="jump-results" id="jump-results" role="listbox" aria-label="Matching chapters" hidden></div>
</dialog>
