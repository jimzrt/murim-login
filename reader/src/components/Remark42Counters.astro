---
const host = "https://murimlogin.duckdns.org";
const siteId = "murim-login";
---

<div hidden data-remark42-counters data-remark42-host={host} data-remark42-site={siteId}></div>

<script>
  async function mountCounters() {
    const boot = document.querySelector<HTMLElement>("[data-remark42-counters]");
    const nodes = [...document.querySelectorAll<HTMLElement>(".remark42__counter[data-url]")];
    if (!boot || !nodes.length || !navigator.onLine) {
      return;
    }
    const host = boot.dataset.remark42Host;
    const siteId = boot.dataset.remark42Site;
    if (!host || !siteId) {
      return;
    }

    const urls = [...new Set(nodes.map((node) => node.dataset.url).filter((url): url is string => Boolean(url)))];
    if (!urls.length) {
      return;
    }

    try {
      const response = await fetch(`${host}/api/v1/counts?site=${encodeURIComponent(siteId)}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(urls),
      });
      if (!response.ok) {
        return;
      }
      const rows = (await response.json()) as Array<{ url: string; count: number }>;
      const counts = new Map(rows.map((row) => [row.url, row.count]));
      for (const node of nodes) {
        const url = node.dataset.url;
        if (!url) {
          continue;
        }
        node.textContent = String(counts.get(url) ?? 0);
      }
    } catch {
      /* leave placeholders */
    }
  }

  document.addEventListener("astro:page-load", () => {
    void mountCounters();
  });
  void mountCounters();
</script>
