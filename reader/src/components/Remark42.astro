---
interface Props {
  chapter: number;
  title?: string;
}

const { chapter, title } = Astro.props;
const host = "https://murim-login.com";
const siteId = "murim-login";
const pageUrl = `chapter-${chapter}`;
const pageTitle = title ?? `Chapter ${chapter}`;
---

<hr class="comments-divider" />
<section
  class="comments system-comments"
  aria-label="Comments"
  data-remark42
  data-remark42-host={host}
  data-remark42-site={siteId}
  data-remark42-url={pageUrl}
  data-remark42-title={pageTitle}
>
  <p class="system-comments__badge" aria-hidden="true">Comments</p>
  <div id="remark42"></div>
  <p class="comments-offline" hidden>Comments need a network connection.</p>
</section>

<script>
  function mountRemark42() {
    const section = document.querySelector<HTMLElement>("[data-remark42]");
    if (!section) {
      return;
    }
    const offline = section.querySelector<HTMLElement>(".comments-offline");
    const mount = section.querySelector<HTMLElement>("#remark42");
    const host = section.dataset.remark42Host;
    const siteId = section.dataset.remark42Site;
    const pageUrl = section.dataset.remark42Url;
    const pageTitle = section.dataset.remark42Title;
    if (!host || !siteId || !pageUrl || !mount) {
      return;
    }

    if (!navigator.onLine) {
      if (offline) {
        offline.hidden = false;
      }
      mount.hidden = true;
      return;
    }

    const win = window as Window & {
      remark_config?: Record<string, unknown>;
      REMARK42?: {
        destroy?: () => void;
        changeTheme?: (theme: string) => void;
      };
    };
    win.REMARK42?.destroy?.();
    mount.replaceChildren();
    mount.hidden = false;
    if (offline) {
      offline.hidden = true;
    }

    win.remark_config = {
      host,
      site_id: siteId,
      url: pageUrl,
      page_title: pageTitle,
      // System plaque is always navy; force Remark42's dark theme for contrast.
      theme: "dark",
      show_rss_subscription: false,
      show_email_subscription: false,
      no_footer: true,
      max_shown_comments: 20,
      // Passed into the iframe as CSS custom properties (see iframe.html).
      // Dark form chrome uses --color8/--color7; keep it open on the plaque.
      __colors__: {
        "--color8": "#0c0c0c18",

        "--color7": "transparent",
      },
    };

    const existing = document.querySelector<HTMLScriptElement>(
      "script[data-remark42-embed]",
    );
    existing?.remove();
    const script = document.createElement("script");
    script.src = `${host}/web/embed.js`;
    script.defer = true;
    script.dataset.remark42Embed = "1";
    script.onerror = () => {
      if (offline) {
        offline.hidden = false;
        offline.textContent = "Comments are temporarily unavailable.";
      }
      mount.hidden = true;
    };
    document.body.appendChild(script);
  }

  // Mount only when the comments near the viewport: cheaper, and the iframe's
  // late growth can't shift the text the reader is on.
  let observer: IntersectionObserver | null = null;
  let observedBody: HTMLElement | null = null;
  function scheduleRemark42() {
    // astro:page-load also fires on the initial window load; once per page.
    if (document.body === observedBody) {
      return;
    }
    observedBody = document.body;
    observer?.disconnect();
    observer = null;
    const section = document.querySelector<HTMLElement>("[data-remark42]");
    if (!section) {
      return;
    }
    if (!("IntersectionObserver" in window)) {
      mountRemark42();
      return;
    }
    observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer?.disconnect();
          observer = null;
          mountRemark42();
        }
      },
      { rootMargin: "800px 0px" },
    );
    observer.observe(section);
  }

  document.addEventListener("astro:page-load", scheduleRemark42);
  scheduleRemark42();

  // Theme follows the navy plaque, not the site theme.
  const themeObserver = new MutationObserver(() => {
    const win = window as Window & {
      REMARK42?: { changeTheme?: (theme: string) => void };
    };
    win.REMARK42?.changeTheme?.("dark");
  });
  themeObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>
