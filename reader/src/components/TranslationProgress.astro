---
import {
  formatRanges,
  loadTranslationProgress,
  percent,
} from "../lib/progress";

const progress = loadTranslationProgress();
const translatedPct = percent(progress.translatedCount, progress.sourceTotal);
const masteredPct = percent(progress.masteredCount, progress.sourceTotal);
const statusHint = `${progress.translatedCount} of ${progress.sourceTotal} translated (${translatedPct}%) · ${progress.masteredCount} mastered (${masteredPct}%)`;
---

<details class="site-intro translation-progress">
  <summary>
    <span class="site-intro__title">Translation progress</span>
    <span class="site-intro__hint">{statusHint}</span>
  </summary>
  <div class="site-intro__body translation-progress__body">
    <div class="translation-progress__bars" role="group" aria-label="Progress bars">
      <div class="translation-progress__row">
        <span class="translation-progress__label">Translated</span>
        <div
          class="translation-progress__track"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow={translatedPct}
          aria-label={`${progress.translatedCount} of ${progress.sourceTotal} translated`}
        >
          <span
            class="translation-progress__fill translation-progress__fill--translated"
            style={`width: ${translatedPct}%`}></span>
        </div>
        <span class="translation-progress__count"
          >{progress.translatedCount}/{progress.sourceTotal}</span
        >
      </div>
      <div class="translation-progress__row">
        <span class="translation-progress__label">Mastered</span>
        <div
          class="translation-progress__track"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow={masteredPct}
          aria-label={`${progress.masteredCount} of ${progress.sourceTotal} mastered`}
        >
          <span
            class="translation-progress__fill translation-progress__fill--mastered"
            style={`width: ${masteredPct}%`}></span>
        </div>
        <span class="translation-progress__count"
          >{progress.masteredCount}/{progress.sourceTotal}</span
        >
      </div>
    </div>

    <dl class="translation-progress__ranges">
      <div>
        <dt>Translated chapters</dt>
        <dd>{formatRanges(progress.translated)}</dd>
      </div>
      <div>
        <dt>Mastered chapters</dt>
        <dd
          >{progress.masteredCount ? formatRanges(progress.mastered) : "none yet"}</dd
        >
      </div>
    </dl>
  </div>
</details>
