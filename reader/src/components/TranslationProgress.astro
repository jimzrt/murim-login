---
import { formatRanges, loadTranslationProgress, percent } from "../lib/progress";

const progress = loadTranslationProgress();
const done = Math.min(progress.translatedCount, progress.sourceTotal);
const translatedPct = percent(done, progress.sourceTotal);
const complete = done >= progress.sourceTotal && progress.missing.length === 0;
const status = complete ? "Translation complete" : "Translation in progress";
const statusHint = `${status} · ${done}/${progress.sourceTotal} chapters (${translatedPct}%)`;
---

<section class="site-intro translation-progress" aria-label="Translation progress">
  <p class="translation-progress__status">
    <span class="site-intro__title">Translation progress</span>
    <span class="site-intro__hint">{statusHint}</span>
  </p>
  <div
    class="translation-progress__track"
    role="progressbar"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow={translatedPct}
    aria-label={`${done} of ${progress.sourceTotal} chapters translated`}
  >
    <span class="translation-progress__fill" style={`width: ${translatedPct}%`}></span>
  </div>
  {
    !complete && (
      <p class="translation-progress__missing">
        Not yet translated: {formatRanges(progress.missing)}
      </p>
    )
  }
</section>
