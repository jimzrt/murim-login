---
import { ClientRouter } from "astro:transitions";
import SiteHeader from "../components/SiteHeader.astro";
import JumpDialog from "../components/JumpDialog.astro";
import SettingsDialog from "../components/SettingsDialog.astro";
import { withBase } from "../lib/chapters";
import "../styles/global.css";

interface Props {
  title: string;
  chapter?: number;
  description?: string;
  ogType?: "website" | "article";
}

const { title, chapter, description, ogType = chapter != null ? "article" : "website" } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site;
const canonical = new URL(Astro.url.pathname, site);
const desc = description ?? "A translation of the web novel Murim Login.";
const ogImage = new URL(withBase("cover.jpg"), site).href;
const manifestHref = withBase("manifest.webmanifest");
---

<!doctype html>
<html lang="en" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Murim Login" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("cover.jpg")} />
    {import.meta.env.PROD && <link rel="manifest" href={manifestHref} />}
    <meta name="theme-color" content="#f3ead4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101826" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function () {
        var theme = "system";
        var size = "m";
        var width = "medium";
        try {
          var saved = JSON.parse(localStorage.getItem("murim-reader") || "null");
          if (saved) {
            if (saved.theme) theme = saved.theme;
            if (saved.fontSize) size = saved.fontSize;
            if (saved.width) width = saved.width;
          } else {
            var legacy = localStorage.getItem("murim-theme");
            if (legacy) theme = legacy;
          }
        } catch (e) {}
        var dark = theme === "dark" || (theme !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
        var root = document.documentElement;
        root.dataset.theme = dark ? "dark" : "light";
        root.dataset.pfTheme = dark ? "dark" : "light";
        root.dataset.size = size;
        root.dataset.width = width;
      })();
    </script>
    {
      import.meta.env.PROD && (
        <>
          <link rel="stylesheet" href={withBase("pagefind/pagefind-component-ui.css")} />
          <style is:inline>
            pagefind-modal,
            pagefind-searchbox {
              color-scheme: inherit;
              --pf-text: var(--ink);
              --pf-text-secondary: var(--muted);
              --pf-text-muted: var(--muted);
              --pf-background: var(--paper);
              --pf-border: var(--rule);
              --pf-border-focus: var(--gold);
              --pf-skeleton: var(--rule);
              --pf-hover: color-mix(in srgb, var(--gold) 14%, var(--paper));
              --pf-mark: var(--navy);
              --pf-outline-focus: var(--accent);
              --pf-font: var(--ui);
              --pf-modal-backdrop: color-mix(in srgb, #0b1220 58%, transparent);
            }
            html[data-theme="dark"] pagefind-modal,
            html[data-theme="dark"] pagefind-searchbox {
              --pf-hover: color-mix(in srgb, var(--navy) 24%, var(--paper));
              --pf-mark: var(--gold-bright);
            }
          </style>
        </>
      )
    }
  </head>
  <body>
    <SiteHeader chapter={chapter} />
    <slot />
    <div transition:persist="jump-dialog">
      <JumpDialog />
    </div>
    <div transition:persist="settings-dialog">
      <SettingsDialog />
    </div>
    {
      import.meta.env.PROD && (
        <>
          <pagefind-config bundle-path={withBase("pagefind/")} base-url={base} />
          <pagefind-modal />
          <script is:inline src={withBase("pagefind/pagefind-component-ui.js")} type="module" />
        </>
      )
    }
    <script src="../scripts/reader.ts"></script>
    {import.meta.env.PROD && <script src="../scripts/pwa.ts"></script>}
  </body>
</html>
